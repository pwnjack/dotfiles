# The repo lives at ~/.config, where every program keeps its own files.
# Everything is ignored unless it is listed here, so a newly installed app
# never shows up in git status. To track a new config, add one ! line.
/*

# Repo files
!/.gitignore
!/.env.example
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/doctor.sh
!/install.sh
!/test.sh
!/docs/
!/screenshots/
!/scripts/
!/test/

# Desktop
!/hypr/
!/waybar/
!/rofi/
!/swaync/
!/quickshell/
!/sddm/
!/updates/
!/wallpapers/
!/waypaper/
!/options/
!/defaults/
!/pipewire/
!/strata/
!/xdg-desktop-portal/
!/swappy/
!/fontconfig/

# Theming
!/gtk-3.0/
!/gtk-4.0/
!/qt5ct/
!/qt6ct/
!/btop/
!/cava/
!/starship/
!/starship.toml
!/vesktop/
!/zen/
!/spicetify/
!/eww/
!/matugen/

# Shell, terminal, editor, tools
!/fish/
!/ghostty/
!/nvim/
!/bat/
!/fastfetch/
!/khal/
!/vdirsyncer/
!/git/
!/ssh/
!/aichat/
!/electron-flags.conf

# ---------------------------------------------------------------------------
# Inside tracked directories: what programs write at runtime.

# Only Strata's fontconfig include is ours
fontconfig/*
!fontconfig/conf.d/
fontconfig/conf.d/*
!fontconfig/conf.d/50-strata-font.conf

# Secrets (API keys); .env.example is the template
.env

# Per-machine state
fish/fish_variables
gtk-3.0/bookmarks
aichat/sessions/
aichat/messages.md
aichat/models-override.yaml

# Rendered by scripts/state/overlay.sh from defaults/ (docs/internals/state.md)
hypr/hyprsunset.conf
options/*
!options/wallpaper
gtk-3.0/settings.ini
gtk-4.0/settings.ini
qt5ct/qt5ct.conf
qt6ct/qt6ct.conf
swaync/config.json
# its write-then-rename file, left behind only by a crash
*.overlay-tmp

# Only the Hyprland portal preference is ours
xdg-desktop-portal/*
!xdg-desktop-portal/hyprland-portals.conf

# Strata's own settings and themes; only the hook and default-theme link are ours
strata/*
!strata/apply_wal_colors.sh
!strata/themes/
strata/themes/*
!strata/themes/tokyo-night.toml

# Vesktop's own state; only the theming hook and its theme are ours
vesktop/*
!vesktop/apply_wal_colors.sh
!vesktop/pywal.theme.css.in
!vesktop/test/
!vesktop/themes/
vesktop/themes/*
!vesktop/themes/pywal.theme.css

# Spicetify's config, backups and downloaded themes; only the Pywal theme,
# its extension and the theming hook are ours
spicetify/*
!spicetify/apply_wal_colors.sh
!spicetify/test/
!spicetify/Themes/
spicetify/Themes/*
!spicetify/Themes/Pywal/
!spicetify/Extensions/
spicetify/Extensions/*
!spicetify/Extensions/pywal-live.js

# Plugin lock and LazyVim's own state file, both rewritten by Neovim
nvim/lazy-lock.json
nvim/lazyvim.json

# Defaults cava recreates on startup
cava/shaders/
cava/themes/

# Downloaded SDDM theme archives
sddm/theme/

# Logs, except the update card's replayed runner logs
*.log
!quickshell/updates/test/fixtures/*.log

# Editor, build and tool leftovers
*.swp
*~
*.bak
*.old
*.tmp
*.lock
*.pid
.DS_Store
*.o
*.so
__pycache__/
.superpowers/
