# Files mgrep must never upload to Mixedbread. Same syntax as .gitignore.
# The repo root is ~/.config, where programs keep personal data and secrets
# beside the tracked files; .gitignore already hides most of it, and this list
# keeps the sensitive entries out of the index even if that ever changes.

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.token

# Personal and per-machine state
options/calendar-*
options/capture-*
khal/
vdirsyncer/
ssh/
aichat/sessions/
aichat/messages.md
fish/fish_variables

# Binary assets: nothing to search, a lot to upload
wallpapers/
screenshots/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.so
