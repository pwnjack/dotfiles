## Configuration file for CAVA.
#
# THIS IS THE TEMPLATE. Edit this file, not cava/config — that one is a symlink
# to the copy rendered into ~/.cache/wal/ by cava/apply_wal_colors.sh, with the
# named role tokens below replaced by the current matugen palette.
#
# Only the colours are set here; every other option keeps cava's built-in
# default (the full list is cava's packaged example config).

[color]

# Horizontal gradients are supported on noncurses output only, one colour per
# bar. The primary tones run dark to light, substituted from the matugen
# palette; the spectrum gradates from low to high frequency. `background` stays
# unset to keep ghostty's transparency showing.
#
# The vertical `gradient` is left off deliberately: cava 0.10.7 corrupts the
# heap and aborts with "free(): invalid next size" on any vertical gradient,
# whatever the stop count — its own bundled themes/solarized_dark crashes it the
# same way. horizontal_gradient is unaffected, so the palette goes there.
horizontal_gradient = 1
horizontal_gradient_color_1 = '@role_primary_t30@'
horizontal_gradient_color_2 = '@role_primary_t40@'
horizontal_gradient_color_3 = '@role_primary_t50@'
horizontal_gradient_color_4 = '@role_primary_t60@'
horizontal_gradient_color_5 = '@role_primary_t70@'
horizontal_gradient_color_6 = '@role_primary_t80@'
horizontal_gradient_color_7 = '@role_primary_t90@'
horizontal_gradient_color_8 = '@role_primary_t95@'
