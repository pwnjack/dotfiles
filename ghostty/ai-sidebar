# AI Sidebar - Ghostty Configuration
# Themed terminal for aichat sidebar

# Colors: ghostty loads ghostty/config before this file, and that already
# includes the matugen palette. Including it again here is a "cycle detected"
# configuration error.

# Typography
font-family = "Fira Code Nerd Font"
font-size = 11

# Window styling for sidebar aesthetic
window-padding-x = 16
window-padding-y = 12
window-decoration = false

# Cursor
cursor-style = bar
cursor-style-blink = true

# Scrollback
scrollback-limit = 10000

# Disable tabs (single purpose sidebar)
window-show-tab-bar = never

# Clean minimal look
resize-overlay = never
mouse-hide-while-typing = true
