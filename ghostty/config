# Ghostty Configuration
# Docs: https://ghostty.org/docs/config
# Run `ghostty +show-config --default --docs` to list all options.
#
# Colors are rendered into ~/.cache/wal/ghostty-colors by
# ~/.config/ghostty/apply_wal_colors.sh on every wallpaper change, and
# included below via `config-file = ?colors` (ghostty/colors is a symlink
# to the rendered file).

# Conventional keybinds
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
# Fullscreen is Hyprland's job (Super+F); let ctrl+enter reach the program
keybind = ctrl+enter=unbind

# Translucent like Waybar and the Quickshell cards (background at 0.68-0.82).
# The cells setting also lets apps that paint their own background (Neovim)
# show through. blur.css asks Hyprland for the blur; background-blur only
# speaks KDE's protocol and does nothing here.
background-opacity = 0.8
background-opacity-cells = true
window-padding-x = 6
window-padding-y = 5
window-padding-balance = true
gtk-custom-css = blur.css

# matugen colours
config-file = ?colors
# The font, rendered from options/font by scripts/fonts/apply-font.sh
# (ghostty/font is a symlink into ~/.local/state).
config-file = ?font
# Every wallpaper change reloads the config; keep that silent
app-notifications = no-config-reload
