# Git reads this file as well as ~/.gitconfig, which keeps identity and
# credentials and stays untracked. Display settings and workflow defaults
# live here; anything in ~/.gitconfig wins over them.
#
# delta pages diffs: syntax highlighting, word-level changes, line numbers.
# Git starts a pager only when writing to a terminal, so scripts still read
# plain output. Without delta it falls back to git's own less / plain diff.
# syntax-theme = ansi follows the terminal's matugen palette; added and removed
# lines keep delta's red and green, which a wallpaper palette cannot promise.
[core]
	pager = "if command -v delta >/dev/null 2>&1; then delta; else less; fi"
[interactive]
	diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi

# zdiff3 shows the merge base inside conflict markers; histogram gives
# readable diffs where code moved. rerere replays a resolution git has seen.
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
[rerere]
	enabled = true
# A first push sets the upstream; fetch drops branches deleted upstream.
[push]
	autoSetupRemote = true
[fetch]
	prune = true
# fixup!/squash! commits move into place, and a rebase carries the branches
# stacked on the one being rewritten.
[rebase]
	autoSquash = true
	updateRefs = true
