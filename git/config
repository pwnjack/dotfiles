# Git reads this file as well as ~/.gitconfig, which keeps identity and
# credentials and stays untracked. Only display settings live here.
#
# delta pages diffs: syntax highlighting, word-level changes, line numbers.
# Git starts a pager only when writing to a terminal, so scripts still read
# plain output. Without delta it falls back to git's own less / plain diff.
# syntax-theme = ansi follows the terminal's matugen palette; added and removed
# lines keep delta's red and green, which a wallpaper palette cannot promise.
[core]
	pager = "if command -v delta >/dev/null 2>&1; then delta; else less; fi"
[interactive]
	diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi
