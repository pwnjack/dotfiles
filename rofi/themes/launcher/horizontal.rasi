// Horizontal launcher: the vertical layout with one row of six large icons.
@import "vertical.rasi"

* {
    lines:                       1;
    columns:                     6;
}
window {
    width:                       980px;
}
inputbar {
    padding:                     50px 60px;
}
entry {
    width:                       300px;
}
button {
    width:                       80px;
    padding:                     12px;
}
element {
    padding:                     25px;
    border-radius:               15px;
    orientation:                 vertical;
}
element-icon {
    size:                        64px;
}
element-text {
    horizontal-align:            0.5;
}
