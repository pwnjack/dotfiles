#!/bin/bash
# secret-tool lookup|store|clear service S field F — one file per field.
printf '%s\n' "$*" >> "$FAKE_LOG/secret-tool.argv"
dir=${FAKE_KEYRING:?}; mkdir -p "$dir"
field=${*: -1}
case $1 in
    lookup) [[ -f $dir/$field ]] && cat "$dir/$field" ;;
    store) shift; IFS= read -r value; printf '%s' "$value" > "$dir/$field" ;;
    clear) rm -f "$dir/$field" ;;
esac
