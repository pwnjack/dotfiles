#!/bin/bash
# secret-tool lookup|store|clear service S field F — one file per field.
printf '%s\n' "$*" >> "$FAKE_LOG/secret-tool.argv"
dir=${FAKE_KEYRING:?}; mkdir -p "$dir"
field=${*: -1}
case $1 in
    lookup) if [[ -n ${FAKE_SECRET_LOOKUP_ERROR:-} ]]; then
                echo 'secret-tool: cannot unlock the keyring' >&2; exit 1
            fi
            [[ -f $dir/$field ]] && cat "$dir/$field" ;;
    store) shift; IFS= read -r value
           [[ ${FAKE_SECRET_FAIL_FIELD:-} == "$field" ]] && exit 1
           printf '%s' "$value" > "$dir/$field" ;;
    clear) [[ -n ${FAKE_SECRET_CLEAR_NOOP:-} ]] || rm -f "$dir/$field" ;;
esac
