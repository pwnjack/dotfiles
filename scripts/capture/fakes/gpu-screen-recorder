#!/usr/bin/env python3
"""Test stand-in for gpu-screen-recorder.

Appends its argument vector to $FAKE_LOG/gsr.argv, then behaves per FAKE_GSR:
  ok (default)  run until SIGINT, then write the -o file and exit 0
  die           print an error and exit 1 at once
  empty         run until SIGINT, then exit without writing anything
  hang          ignore SIGINT; only SIGKILL ends it
FAKE_GSR_FINISH delays the finish by that many seconds.

Python, not bash: a background job of a non-interactive shell starts with
SIGINT ignored, and bash cannot handle a signal that was ignored on entry.
The real recorder (C) installs its own handler, which record.sh relies on.
"""
import os
import signal
import sys
import time

log = os.environ["FAKE_LOG"]
mode = os.environ.get("FAKE_GSR", "ok")
out = sys.argv[sys.argv.index("-o") + 1]


def finish(*_):
    time.sleep(float(os.environ.get("FAKE_GSR_FINISH", "0")))
    if mode != "empty":
        with open(out, "wb") as f:
            f.write(b"fake mp4")
    sys.exit(0)


signal.signal(signal.SIGINT, signal.SIG_IGN if mode == "hang" else finish)
# The argument log also means SIGINT is ready: tests racing start with stop
# must wait for this condition, rather than assuming Python starts in N ms.
with open(os.path.join(log, "gsr.argv"), "a") as f:
    f.write(" ".join(sys.argv[1:]) + "\n")
if mode == "die":
    print("gsr error: failed to open the capture device", file=sys.stderr)
    sys.exit(1)
while True:
    time.sleep(0.05)
