"$schema" = 'https://starship.rs/config-schema.json'

# THIS IS THE TEMPLATE. Edit this file, not ~/.config/starship.toml — that one
# is a symlink to the copy rendered into ~/.cache/wal/ by
# starship/apply_wal_colors.sh.
#
# Named tokens use matugen's semantic fills and matching text roles.
# The powerline segments run through primary, primary and secondary containers,
# the tertiary container, then raised surfaces. Separators match adjacent fills.

add_newline = true

format = """
[ ](@role_primary@)\
$python\
$username\
[](bg:@role_primary_container@ fg:@role_primary@)\
$directory\
[](fg:@role_primary_container@ bg:@role_secondary_container@)\
$git_branch\
$git_status\
[](fg:@role_secondary_container@ bg:@role_tertiary_container@)\
$c\
$elixir\
$elm\
$golang\
$haskell\
$java\
$julia\
$nodejs\
$nim\
$rust\
[](fg:@role_tertiary_container@ bg:@role_surface_container_highest@)\
$docker_context\
[](fg:@role_surface_container_highest@ bg:@role_surface_container_high@)\
$os\
[ ](@role_surface_container_high@)\
"""

right_format = """
[ ](@role_surface_container_high@)\
$cmd_duration\
$time
[ ](@role_surface_container_high@)\
"""

command_timeout = 500

[username]
show_always = true
style_user = "bg:@role_primary@ fg:@role_on_primary@"
style_root = "bg:@role_primary@ fg:@role_on_primary@"
format = '[$user ]($style)'

[directory]
style = "bg:@role_primary_container@ fg:@role_on_primary_container@"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "

[c]
symbol = " "
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[docker_context]
symbol = " "
style = "bg:@role_surface_container_highest@ fg:@role_on_surface@"
format = '[ $symbol $context ]($style) $path'

[elixir]
symbol = " "
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[elm]
symbol = " "
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[git_branch]
symbol = ""
style = "bg:@role_secondary_container@ fg:@role_on_secondary_container@"
format = '[ $symbol $branch ]($style)'

[git_status]
style = "bg:@role_secondary_container@ fg:@role_on_secondary_container@"
format = '[$all_status$ahead_behind ]($style)'

[golang]
symbol = " "
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[haskell]
symbol = " "
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[java]
symbol = " "
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[julia]
symbol = " "
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[nodejs]
symbol = ""
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[nim]
symbol = " "
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[python]
symbol = " "
# Uses primary to match the first segment: $python sits in the
# first block of `format`, ahead of $username, so it has to match that block's
# background or an active virtualenv punches a mismatched chunk into it.
style = "bg:@role_primary@ fg:@role_on_primary@"
format = '[(\($virtualenv\) )]($style)'

[rust]
symbol = " "
style = "bg:@role_tertiary_container@ fg:@role_on_tertiary_container@"
format = '[ $symbol ($version) ]($style)'

[time]
disabled = false
time_format = "%R"
style = 'fg:@role_on_surface_variant@ bg:@role_surface_container_high@'
format = '[ $time ]($style)'

# Shares the time pill on the right; appears only once a command runs past
# min_time, so quick commands leave the prompt unchanged.
[cmd_duration]
min_time = 2000
style = 'fg:@role_on_surface_variant@ bg:@role_surface_container_high@'
format = "[ \U000F051B $duration ]($style)"

[os]
format = "[ $symbol ]($style)"
style = 'fg:@role_on_surface_variant@ bg:@role_surface_container_high@'
disabled = false

[os.symbols]
# Without an entry starship falls back to its own CachyOS emoji (a ribbon);
# use the Arch glyph, since CachyOS is Arch-based.
CachyOS = "\U000F08C7"
Arch = "󰣇"
Fedora = ""
